generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Hacker {
  id          String   @id @default(cuid())
  handle      String   @unique // display name / alias
  team        String?  // group / crew affiliation
  country     String?  // origin country (ISO code)
  avatarColor String   @default("#22c55e")
  rank        Int      @default(0) // computed score
  totalHits   Int      @default(0)
  badges      String   @default("[]") // JSON array of badge ids
  bio         String?
  joinedAt    DateTime @default(now())
  defacements Defacement[]
}

model Defacement {
  id          String   @id @default(cuid())
  targetUrl   String   
  targetName  String   
  country     String   
  category    String   
  attackerId  String
  attacker    Hacker   @relation(fields: [attackerId], references: [id])
  mirrorUrl   String?  
  note        String?  
  poc         String?  
  reason      String?  
  isHomepage  Boolean  @default(false) 
  isMass      Boolean  @default(false) 
  isRedeface  Boolean  @default(false) 
  isSpecial   Boolean  @default(false) 
  pendingUntil DateTime? 
  status      String   @default("archived") 
  severity    String   @default("medium") 
  createdAt   DateTime @default(now())

  @@index([attackerId])
  @@index([country])
  @@index([createdAt])
}

model Stat {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Int      @default(0)
}

model News {
  id        String   @id @default(cuid())
  title     String
  body      String
  author    String   
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
