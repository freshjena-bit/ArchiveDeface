{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "deface-archive",
  "main": ".open-next/worker/index.js",
  "compatibility_date": "2025-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Cloudflare D1 (edge SQLite) — provision with:
  //   npx wrangler d1 create deface-archive
  // then paste the returned database_id below.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "deface-archive",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "ADMIN_USERNAME": "GadaLuBau",
    "ADMIN_PASSWORD": "slametwkw"
  }
}
